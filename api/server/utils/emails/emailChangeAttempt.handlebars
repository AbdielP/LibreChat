<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Se pidió cambiar tu correo</title>
  </head>
  <body style='margin:0;background:#f5f5f5;font-family:Arial,sans-serif;color:#1f2937'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center' style='padding:32px 16px'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='max-width:560px;background:#ffffff;border-radius:12px'
          >
            <tr>
              <td style='padding:32px'>
                <h1 style='margin:0 0 20px;font-size:24px'>Se pidió cambiar tu correo</h1>
                <p>Hola, {{name}}:</p>
                <p>
                  Se pidió cambiar el correo de tu cuenta de
                  {{appName}}
                  por
                  <strong>{{newEmail}}</strong>.
                </p>
                <p><strong>Fecha:</strong>
                  {{requestedAt}}<br /><strong>Dirección IP:</strong>
                  {{ip}}</p>
                <p>
                  Si no fuiste tú, cambia tu contraseña de inmediato y escríbenos.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>