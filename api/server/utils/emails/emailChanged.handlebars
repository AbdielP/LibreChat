<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Tu correo cambió</title>
  </head>
  <body style='margin:0;background:#f5f5f5;font-family:Arial,sans-serif;color:#1f2937'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center' style='padding:32px 16px'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='max-width:560px;background:#ffffff;border-radius:12px'
          >
            <tr>
              <td style='padding:32px'>
                <h1 style='margin:0 0 20px;font-size:24px'>Tu correo cambió</h1>
                <p>Hola, {{name}}:</p>
                <p>El correo de tu cuenta de {{appName}} se cambió correctamente.</p>
                <p>
                  <strong>Correo anterior:</strong>
                  {{oldEmail}}<br />
                  <strong>Correo nuevo:</strong>
                  {{newEmail}}<br />
                  <strong>Fecha:</strong>
                  {{changedAt}}<br />
                  <strong>Dirección IP:</strong>
                  {{ip}}
                </p>
                <p>
                  Si no fuiste tú, escríbenos de inmediato y cambia tu contraseña.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>