<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Confirma tu correo nuevo</title>
  </head>
  <body style='margin:0;background:#f5f5f5;font-family:Arial,sans-serif;color:#1f2937'>
    <table role='presentation' width='100%' cellpadding='0' cellspacing='0'>
      <tr>
        <td align='center' style='padding:32px 16px'>
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='max-width:560px;background:#ffffff;border-radius:12px'
          >
            <tr>
              <td style='padding:32px'>
                <h1 style='margin:0 0 20px;font-size:24px'>Confirma tu correo nuevo</h1>
                <p>Hola, {{name}}:</p>
                <p>Confirma<strong>{{newEmail}}</strong>
                  como el correo nuevo de tu cuenta de
                  {{appName}}
                  . El enlace vence en {{linkLifetime}}.
                </p>
                <p style='margin:28px 0'>
                  <a
                    href='{{verificationLink}}'
                    style='display:inline-block;border-radius:8px;background:#2563eb;padding:12px 20px;color:#ffffff;text-decoration:none'
                  >Confirmar correo nuevo</a>
                </p>
                <p>Si no lo pediste, ignora este correo.</p>
                <p style='margin-top:28px;color:#6b7280;font-size:12px'>&copy;
                  {{year}}
                  {{appName}}</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>